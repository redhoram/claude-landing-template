# Dependencies
/node_modules
.pnp
.pnp.*

# Production
/dist
/dist-ssr

# Environment & secrets: NEVER commit these
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# OS / editor
.DS_Store
Thumbs.db
*.pem
.vscode/*
!.vscode/extensions.json
.idea/

# TypeScript
*.tsbuildinfo

# Vite cache
.vite/

# Craft scratchpads (regenerated on each /craft; old runs move to .craft/archive/).
# brand.md is kept in git (it is the project's brand system). Remove the lines below if you also want to commit the other run files, screenshots, and their archive.
.craft/*.md
!.craft/brand.md
.craft/shots/
.craft/archive/

# Local Claude Code settings (per machine, never committed)
.claude/settings.local.json
