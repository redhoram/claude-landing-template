# Dependencies
/node_modules
.pnp
.pnp.*

# Production
/dist
/dist-ssr

# Environment & secrets: NEVER commit these
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# OS / editor
.DS_Store
Thumbs.db
*.pem
.vscode/*
